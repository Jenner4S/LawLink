# LawLink 环境变量模板
# 复制为 .env 后填入真实值。.env 不会进 git，绝不提交。

# —— 数据库 ——
# 本地开发（直连 Postgres）：
DATABASE_URL="postgresql://lawlink:lawlink@localhost:5432/lawlink?schema=public"

# Postgres 容器变量（仅 docker compose 用）
POSTGRES_DB=lawlink
POSTGRES_USER=lawlink
POSTGRES_PASSWORD=lawlink
POSTGRES_PORT=5432

# —— 鉴权 ——
# 生成方法：openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE_WITH_OUTPUT_OF_openssl_rand_base64_32"
NEXTAUTH_URL="http://localhost:3000"

# —— OIDC 单点登录（可选，台账 P2-2）——
# 用途：律所 / 集团已有企业身份系统（Azure AD / 飞书 / 企业微信 / Keycloak / Okta），
# 用 IdP 统一登录。SSO 只把 IdP 身份映射到**本系统已存在且已启用**的 User（按邮箱精确匹配），
# 不会自动建号；匹配不到一律拒绝并写审计 SSO_LOGIN_REJECT。
# 未设 AUTH_OIDC_ENABLED=1 时，登录页不显示 SSO 按钮，providers 里也没有该 provider。
#
# 注意：
# 1) 配置只走环境变量（providers 数组在模块加载时求值）。管理后台只做只读状态展示，
#    改后台不会改配置——请改本文件对应部署的环境变量后重启。
# 2) issuer 必须是 https（仅本机 localhost / 127.0.0.1 允许 http，便于本地联调 Keycloak）。
# 3) IdP 侧的回调地址填：{NEXTAUTH_URL}/api/auth/callback/oidc
# 4) 已开启两步验证（TOTP）的账号不能走 SSO（SSO 无法提交第二因子），
#    会提示改用账号密码 + 动态码登录。
# AUTH_OIDC_ENABLED=1
# AUTH_OIDC_ISSUER="https://login.microsoftonline.com/REPLACE_TENANT/v2.0"
# AUTH_OIDC_CLIENT_ID=""
# AUTH_OIDC_CLIENT_SECRET=""
# 登录页按钮文案，缺省「企业登录」
# AUTH_OIDC_DISPLAY_NAME="企业统一登录"
# 可选，缺省 openid email profile（总会补上 openid）
# AUTH_OIDC_SCOPES="openid email profile"

# —— WebAuthn / Passkey（可选，台账 P2-2 后半）——
# 用途：用设备指纹 / 面容 / PIN 代替密码登录。通行密钥绑定站点来源，钓鱼站点拿到的
# 断言无法通过验签，因此在律所这种"账号被撞开代价极高"的场景比密码更安全。
#
# 两条硬要求：
# 1) **未配置时功能整体关闭**：登录页不出现按钮、服务端入口直接拒绝（不降级）。
# 2) rpID 与 origin 只能在这里配，**绝不从请求头推断**——Host 头可伪造，用它当
#    expectedOrigin 等于让假域名上的断言也能验签通过。
#
# 配置说明：
# - AUTH_WEBAUTHN_ORIGIN：站点来源，必须 https；只有本机 localhost / 127.0.0.1 允许 http
#   （本地开发：AUTH_WEBAUTHN_ORIGIN="http://localhost:3000"，AUTH_WEBAUTHN_RP_ID=localhost）。
#   不能带路径（写 "https://law.example.com"，不要写 "https://law.example.com/login"）。
# - AUTH_WEBAUTHN_RP_ID：域名，必须是 origin 主机名本身或其上级域
#   （站点在 law.example.com 时可填 law.example.com 或 example.com）。
# - 换域名/换协议会导致已绑定的通行密钥全部失效（WebAuthn 的防钓鱼正是靠这个绑定）。
# - 已开启两步验证（TOTP）的账号，用 Passkey 登录时仍需动态码；管理员强制开启但本人
#   未绑定的账号，Passkey 登录同样被拒（与密码登录同口径）。
# AUTH_WEBAUTHN_RP_ID=""
# AUTH_WEBAUTHN_RP_NAME="LawLink"
# AUTH_WEBAUTHN_ORIGIN=""

# —— 文件存储与加密 ——
APP_STORAGE_DIR="./storage"
# 文件加密主密钥（AES-256-GCM），base64 编码的 32 字节
# 生成方法：openssl rand -base64 32
# ⚠️ 丢失此密钥则所有加密材料不可恢复，独立于数据库备份
STORAGE_ENCRYPTION_KEY="REPLACE_WITH_OUTPUT_OF_openssl_rand_base64_32"

# —— 云存储（可选，v0.17）——
# 切到 s3 时所有后续 writeFile 都写 S3；已写的 local 文件不会自动迁移
# STORAGE_PROVIDER="local"     # 默认 local；改为 "s3" 启用云存储
# AWS_REGION="ap-northeast-1"
# S3_BUCKET="lawlink-storage"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""               # 可选，自建 S3 兼容（MinIO / R2 / 阿里云 OSS 兼容端点）
# S3_FORCE_PATH_STYLE="false"  # MinIO 必须 true
# S3_KEY_PREFIX="prod/"        # 可选，所有对象 key 前缀

# —— 初始管理员（仅 seed 时使用）——
SEED_ADMIN_EMAIL="admin@lawlink.local"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
SEED_ADMIN_NAME="系统管理员"

# v0.50 自动备份（每天 02:30，调 scripts/backup.sh）
# BACKUP_CRON_ENABLED=false   # 部署环境没有 pg_dump 时关闭
# BACKUP_DIR=./backups        # 备份输出目录
# BACKUP_KEEP=14              # 保留最近 N 份

# —— 运维开关 ——
# AuditLog 保留检查阈值（天）：每天 03:00 统计超期可归档数量（仅统计，从不物理删除）
# AUDIT_RETENTION_DAYS=365
# 提醒送达台账明细保留天数（每天 03:10 清理超期行；仅台账，不涉及 AuditLog）
# REMINDER_LEDGER_RETENTION_DAYS=180
# 禁用进程内定时作业（=1 时）：提醒扫描、备份、队列 worker 全部不注册，
# 仅供调试或使用外部调度器时使用；本地开发（npm run dev）本就不跑定时作业
# DISABLE_CRON=1

# ---- 邮件提醒（SMTP，v1.x 个人提醒渠道） ----
# 留空则邮件渠道自动停用（站内通知与群机器人不受影响）。
# 本地联调：docker compose --profile dev up mailpit，然后
#   SMTP_HOST=localhost SMTP_PORT=1025 MAIL_FROM=lawlink@localhost
# 收件箱界面 http://localhost:8025
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ── 官网/公众号表单入站（2026-11-23）────────────────────────────
# 配一个随机串（如 openssl rand -hex 24），表单侧以 x-inbound-token 头带上同一个值。
# 不配则接口返回 503（不静默放行：等于公网任何人都能造线索）。
# 接口：POST /api/inbound/lead  {"name":"张三","phone":"139...","channelName":"大众点评","externalId":"表单提交id"}
INBOUND_LEAD_TOKEN=
