}

/// 费率表：四级覆盖，解析时按 MATTER > CLIENT > USER > ROLE > DEFAULT 就近取用
model RateSchedule {
  id               String    @id @default(cuid())
  scope            RateScope
  matterId         String?
  matter           Matter?   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  clientId         String?
  client           Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?     @relation("RateScheduleUser", fields: [userId], references: [id], onDelete: Cascade)
  role             UserRole?
  /// 标准小时费率（元/小时）
  hourlyRate       Decimal   @db.Decimal(12, 2)
  /// 计费进位（分钟）；0 = 按实际分钟计。律所惯例 6 分钟 = 0.1 小时
  billingIncrement Int       @default(0)
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  note             String?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  timeEntries TimeEntry[]

  @@index([scope, active])
  @@index([matterId])
  @@index([clientId])
  @@index([userId])
}

/// 工时记录
model TimeEntry {
  id       String @id @default(cuid())
  matterId String
  matter   Matter @relation(fields: [matterId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation("TimeEntryUser", fields: [userId], references: [id], onDelete: Restrict)

  workDate       DateTime @db.Date
  minutes        Int
  /// 工作内容（律师可读的叙述）
  narrative      String   @db.Text
  /// 自定义任务分类：阅卷 / 开庭 / 起草 / 沟通 …
  taskCode       String?
  billable       Boolean  @default(true)
  /// 不可计费时必填理由
  noChargeReason String?

  /// 费率快照：录入当时锁定，不随费率表调整而变
  rateScheduleId     String?
  rateSchedule       RateSchedule? @relation(fields: [rateScheduleId], references: [id], onDelete: SetNull)
  hourlyRateSnapshot Decimal       @db.Decimal(12, 2)
  amount             Decimal       @db.Decimal(12, 2)
  /// 计费分钟（进位后），与 minutes 区分：actual 是实际投入，billableMinutes 是计费依据
  billableMinutes    Int

  /// 出账关联
  billingId String?
  billing   Billing? @relation(fields: [billingId], references: [id], onDelete: SetNull)

  status       TimeEntryStatus @default(DRAFT)
  approvedById String?
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([matterId, workDate])
  @@index([userId, workDate])
  @@index([status])
  @@index([billingId])
}

// ============ 隔离墙 Ethical Wall（2026-11-19 新增）============
// 与利益冲突检索的区别：
//   利冲（ConflictCheck）回答「这个案子能不能接」——接案前的判断；
//   隔离墙（EthicalWall）回答「接了之后，所内哪些人不能看」——接案后的信息隔离。
// 隔离墙是执业合规要求，不是权限设置：它对全所生效，包括合伙人、管理员、超级管理员。
// 典型场景：代理 A 公司诉 B 公司，所内同时为 B 公司提供常年顾问的团队必须被隔离。

enum EthicalWallTargetType {
  USER
  TEAM
  ROLE
}

model EthicalWall {
  id       String @id @default(cuid())
  matterId String
  matter   Matter @relation(fields: [matterId], references: [id], onDelete: Cascade)

  /// 隔离理由（必填）：合规留痕，说明为什么隔离、涉及哪一方
  reason String @db.Text

  active    Boolean   @default(true)
  /// 有效期；为空表示永久生效直到手动解除
  expiresAt DateTime?

  createdById String
  createdBy   User   @relation("EthicalWallCreator", fields: [createdById], references: [id], onDelete: Restrict)

  liftedAt   DateTime?
  liftedById String?
  liftedBy   User?     @relation("EthicalWallLifter", fields: [liftedById], references: [id], onDelete: SetNull)
  liftReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  denials EthicalWallDenial[]

  @@index([matterId, active])
  @@index([active, expiresAt])
}

/// 被隔离的对象。三种目标互斥：按人、按团队、按角色。
model EthicalWallDenial {
  id     String      @id @default(cuid())
  wallId String
  wall   EthicalWall @relation(fields: [wallId], references: [id], onDelete: Cascade)

  /// 被隔离对象的类别。刻意不叫 targetType——那个名字在本项目专指审计对象类型，
  /// 复用会让「全仓 targetType 字面量都必须有中文标签」的元测试误报。
  denyType EthicalWallTargetType

  userId String?
  user   User?   @relation("EthicalWallDeniedUser", fields: [userId], references: [id], onDelete: Cascade)

  teamId String?
  team   Team?   @relation("EthicalWallDeniedTeam", fields: [teamId], references: [id], onDelete: Cascade)

  role UserRole?

  @@index([wallId])
  @@index([userId])
  @@index([teamId])
}

// ============ 邮件归档 Email Archive（2026-11-19 新增，台账 P1-3）============
// 律所与客户/法院的沟通大量在邮件里。此前系统只发不存，后果是：
//   ① 更换承办律师时历史沟通断档；② 客户追问当时承诺时翻不到；③ 利冲与执业风险排查缺证据。
// 本轮无 IMAP 接入，最低成本通道是「粘贴邮件归档」；匹配算法给出归属建议，命中多案不猜，交人工指定。
// 隐私约定：邮件正文属客户通信内容，读取一律跟随案件的可见性（assertCanReadMatter），
// 待归档队列在管理侧，普通律师只看自己归档的未匹配件。

enum EmailMatchKind {
  /// 正文或主题含案件编号（internalCode / firmCaseNo）
  MATCHED_BY_CODE
  /// 正文含唯一归属的当事人全名
  MATCHED_BY_PARTY
  /// 发件人邮箱与客户/联系人邮箱一致
  MATCHED_BY_ADDRESS
  /// 人工指定
  MANUAL
  /// 未匹配（含命中多案需人工指定的情况）
  UNMATCHED
}

model EmailArchive {
  id              String   @id @default(cuid())
  subject         String
  fromAddress     String
  fromName        String?
  /// 多个收件人 / 抄送
  toAddresses     String[]
  ccAddresses     String[]
  sentAt          DateTime
  bodyText        String   @db.Text
  bodyHtml        String?  @db.Text
  /// 附件数量。本轮仅粘贴归档（无附件上传通道），恒为 0；接入 IMAP 后由取件器回填。
  attachmentCount Int      @default(0)

  /// 归属案件（可空：尚未匹配）
  matterId String?
  matter   Matter? @relation(fields: [matterId], references: [id], onDelete: SetNull)

  /// 匹配依据类别
  matchKind     EmailMatchKind @default(UNMATCHED)
  /// 匹配依据的可读说明，如「正文含案号 LL-2026-CC-0001」
  matchEvidence String?

  archivedById String
  archivedBy   User   @relation("EmailArchiver", fields: [archivedById], references: [id], onDelete: Restrict)

  /// RFC Message-ID，用于去重；为空表示来源未提供
  messageId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([matterId, sentAt])
  @@index([matchKind, sentAt])
  @@index([fromAddress])
}

// ============ WebAuthn / Passkey（台账 P2-2 后半，2026-11-19）============
// 密码是最大的攻击面（钓鱼、撞库、复用）。Passkey 用设备生物识别替代密码，
// 且天然抗钓鱼——签名绑定 rpID + origin，假站点拿到的断言一律验签失败。
//
// 两条安全设计（写在此处，避免后人误改）：
//   1. **challenge 必须落库**：多实例部署下进程内 Map 会随机失效（A 实例发挑战、
//      B 实例验签），表现为"偶发登录失败"。落库后由 usedAt + expiresAt 做原子一次性消费。
//   2. **counter 必须校验**：认证器每次签名递增 counter，克隆的凭证无法让真凭证的
//      counter 前进，因此"新 counter <= 已存 counter"是发现克隆的唯一手段。

model WebAuthnCredential {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Base64URL 编码的 credential ID（浏览器侧 WebAuthnCredential.id）
  credentialId String    @unique
  /// Base64URL 编码的 COSE 公钥
  publicKey    String    @db.Text
  /// 签名计数器（BigInt：部分认证器 counter 为 32 位无符号且可能很大）
  counter      BigInt    @default(0)
  /// usb / nfc / ble / internal / hybrid（浏览器上报，用于 allowCredentials 提示）
  transports   String[]
  /// 用户可读备注，如「MacBook 指纹」
  deviceName   String?
  /// 是否为可同步的 passkey（多设备凭证）。仅记录事实，不参与准入判定
  backedUp     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

/// WebAuthn 挑战与会话票据（登录 ticket 同表存储，见 src/lib/auth/webauthn.ts）。
///
/// kind 取值：
///   - `register`        注册挑战（5 分钟）
///   - `login`           登录挑战（5 分钟，userId 可为空＝无用户名发现）
///   - `TICKET`          Passkey 断言已验证、一次性登录票据（60 秒）
///   - `TICKET_2FA`      同上，但该账号的两步验证已在验签环节通过
model WebAuthnChallenge {
  id        String    @id @default(cuid())
  challenge String    @unique
  /// 注册时有值；登录时可为空（无用户名发现），验证成功后回填匹配到的用户
  userId    String?
  /// register / login / TICKET / TICKET_2FA
  kind      String
  expiresAt DateTime
  usedAt    DateTime?

  @@index([expiresAt])
}

// ============================================================
// 合同确认留痕（台账 P1-4 降级实现）
// ============================================================
//
// 合规定位（决定功能边界，勿越过）：
//   《中华人民共和国电子签名法》第 13 条的可靠电子签名要求「专有控制」+
//   「签署后改动可发现」+「签署人身份可信」。本模型只保存「客户对某一版正文
//   表示已阅知并确认」的时间/IP/UA/正文哈希，不构成电子签名，不能替代签字盖章。
//   它的用途是证据链：事后争议时能举证「该客户于 X 时间、Y IP 确认了哈希为 Z
//   的内容」。
//
// 安全约束：
//   - 访问令牌 32 字节随机，明文只出现在发出的链接里；库中只存 SHA-256。
//   - contentHash 是 contentSnapshot 的 SHA-256，展示与确认时均复核，
//     防止有人直接改库里的快照（改了就与签发时的哈希对不上）。
enum ConfirmationStatus {
  PENDING
  CONFIRMED
  EXPIRED
  REVOKED
}

model ContractConfirmation {
  id           String      @id @default(cuid())
  clientId     String
  client       Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  engagementId String?
  engagement   Engagement? @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  matterId     String?
  matter       Matter?     @relation(fields: [matterId], references: [id], onDelete: SetNull)

  /// 送达给客户看的正文快照——事后可完整复现「客户当时看到的是什么」
  contentSnapshot String @db.Text
  /// contentSnapshot 的 SHA-256（客户确认后若有人改快照，这里对不上）
  contentHash     String

  /// 访问令牌的哈希（明文只出现在发出的链接里，不落库）
  tokenHash String   @unique
  expiresAt DateTime

  status        ConfirmationStatus @default(PENDING)
  confirmedAt   DateTime?
  confirmedIp   String?
  confirmedUa   String?
  /// 客户自报姓名（可不填；用于佐证）
  confirmerName String?

  revokedAt     DateTime?
  revokedReason String?
  createdById   String
  createdBy     User      @relation("ContractConfirmationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([clientId, status])
  @@index([tokenHash])
  @@index([status, expiresAt])
}

// ============================================================
// 客户门户 S1：身份与邀请（2026-11-20）
// 分期说明见 docs/客户门户架构方案-20261120.md §六。
// S1 只建这两张表；PortalShare / PortalRequest / PortalSatisfaction
// 随 S2/S3 落地时再加，避免先建空表却无人使用。
// ============================================================

/// 门户用户：客户方的自然人账号，与员工 User 结构性隔离
model ClientPortalUser {
  id             String                       @id @default(cuid())
  clientId       String
  client         Client                       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  email          String                       @unique
  name           String
  passwordHash   String
  active         Boolean                      @default(true)
  /// 是否主账号（方案 §七 Q3：一客户一主账号，其余为协作者）
  ///
  /// 只影响**这张清单怎么展示**与「谁是这家客户的对接人」，
  /// 不影响可见性：协作者默认可见该客户全部已分享内容（Q3 默认档）。
  /// 「仅自己提交的」档要等工单（S3）落地才有作用对象，现在引入就是假开关。
  isPrimary      Boolean                      @default(true)
  /// 协作者可见性（方案 §七 Q3 第二档）
  ///
  /// 主账号永远是 ALL（不受此列约束）。
  /// 协作者默认 ALL（同客户内部本就互通）；怕内部政治的大客户可切 OWN_SUBMISSIONS。
  /// 注意：本档**只影响工单**（PortalRequest）——
  /// 已分享材料对协作者一律可见，那是客户级披露，不是"谁提交的"。
  visibility     PortalCollaboratorVisibility @default(ALL)
  /// 与员工侧同机制：递增即让该客户所有旧会话失效
  sessionVersion Int                          @default(0)
  lastLoginAt    DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  invites  PortalInvite[]
  requests PortalRequest[]
  ratings  PortalSatisfaction[]

  @@index([clientId])
}

/// 邀请链接：一次性 token，只存哈希
model PortalInvite {
  id           String           @id @default(cuid())
  portalUserId String
  portalUser   ClientPortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  /// 只存 sha256(明文 token)，不存原文；原文只在生成时返回一次
  tokenHash    String           @unique
  expiresAt    DateTime
  usedAt       DateTime?
  /// 发起邀请的员工 User.id（不建外键：员工离职不删除历史邀请记录）
  createdById  String
  createdAt    DateTime         @default(now())

  @@index([portalUserId])
}

// ============================================================
// 客户门户 S2：披露（2026-11-20）
//
// 铁律（方案 §二 决策 2）：**门户里不存在任何「自动可见」的路径。**
// 没有 PortalShare 里的行，客户什么都看不到；
// 要看，就必须有人点过「分享」，而这个动作留在审计里。
//
// 为什么这条不能妥协：律所最贵的风险不是效率，是不该给客户看的东西给了客户。
// 一份带内部评估意见的案情分析发出去，可能直接输掉一个案子。
// ============================================================

enum PortalShareType {
  DOCUMENT // 单份材料
  MATTER_SUMMARY // 案件进度摘要（仅白名单字段）
  INVOICE // 单张发票
  BILLING // 结算单/账目摘要
}

/// 披露记录：门户可见性的**唯一**来源
model PortalShare {
  id          String          @id @default(cuid())
  clientId    String
  client      Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  shareType   PortalShareType
  /// 按 shareType 只有一个非空：
  ///   DOCUMENT       → documentId
  ///   MATTER_SUMMARY → matterId
  ///   INVOICE        → invoiceId
  ///   BILLING        → matterId（账单属于案件）
  documentId  String?
  matterId    String?
  invoiceId   String?
  /// 发起分享的员工 User.id（不建外键：员工离职不应删除历史披露记录——那是留痕）
  sharedById  String
  sharedAt    DateTime        @default(now())
  /// 撤销即软删：行保留，客户立即看不到，且能回答「什么时候撤的、谁撤的」
  revokedAt   DateTime?
  revokedById String?
  note        String?
  createdAt   DateTime        @default(now())

  @@index([clientId, shareType])
  @@index([clientId, revokedAt])
  @@index([documentId])
  @@index([matterId])
}

// ============================================================
// 客户门户 S3：工单与满意度（2026-11-21）
//
// 这是客户**唯一能主动发起**的通道。设计要点：
//   · 工单归属于「门户账号」而不只是客户——同一客户的协作者之间可以各自提交；
//     能否看到彼此的工单由 ClientPortalUser.visibility 决定（Q3 第二档）。
//   · 员工侧回答落 answerBody + answeredById + answeredAt：留痕，不覆盖原内容。
//   · 满意度一案件一次、可选匿名（匿名时只存评分不存账号，避免"给差评会被认出来"）。
// ============================================================

enum PortalCollaboratorVisibility {
  /// 可见该客户全部工单（默认）
  ALL
  /// 仅见自己提交的工单
  OWN_SUBMISSIONS
}

enum PortalRequestStatus {
  OPEN // 客户已提交，待律所处理
  ANSWERED // 律所已回复
  CLOSED // 已关闭
}

/// 客户工单
model PortalRequest {
  id           String              @id @default(cuid())
  portalUserId String
  portalUser   ClientPortalUser    @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  /// 冗余客户 id：查询按客户过滤时不必再 join 账号表，也让「客户删除」这类检查更直接
  clientId     String
  subject      String
  body         String
  status       PortalRequestStatus @default(OPEN)
  /// 员工侧承诺的回复时限（默认 2 个工作日，由服务端按提交时刻计算）
  dueAt        DateTime?
  answeredById String?
  answeredAt   DateTime?
  answerBody   String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([status, dueAt])
  @@index([clientId, createdAt])
  @@index([portalUserId, createdAt])
}

/// 满意度评价：一个案件一次
model PortalSatisfaction {
  id           String            @id @default(cuid())
  portalUserId String?
  portalUser   ClientPortalUser? @relation(fields: [portalUserId], references: [id], onDelete: SetNull)
  clientId     String
  client       Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  matterId     String
  /// 补关系而不是在内存里过滤：报表口径要能直接叠加隔离墙（access.matters），
  /// 否则「被墙挡住案件的评价」会出现在看板上。为此本关系带真实外键。
  matter       Matter            @relation(fields: [matterId], references: [id], onDelete: Cascade)
  /// 1..5
  score        Int
  /// 0..10（NPS），可选
  npsScore     Int?
  comment      String?
  /// 匿名提交：portalUserId 置空，只保留客户级归属（律所仍需知道是哪家客户）
  anonymous    Boolean           @default(false)
  createdAt    DateTime          @default(now())

  @@unique([clientId, matterId])
  @@index([clientId, createdAt])
  @@index([matterId])
}

// ============================================================
// 获客 → 邀约 → 到店谈案（2026-11-21，全链路数字化 阶段 1）
//
// 为什么单独建模而不复用 Intake：
//   Intake 是**已经决定接这个案子**之后的登记（要走冲突检索与审批）。
//   线索阶段大量是「问一句就走」「还没决定要不要委托」，把它塞进 Intake 会让
//   收案列表被噪声污染，也无法统计转化率——而转化率正是获客要回答的唯一问题。
//
// 状态机（单向推进，可标记流失）：
//   LEAD（线索）→ INVITED（已邀约）→ VISITED（已到店）→ CONSULTED（已谈案）
//   → CONVERTED（已转收案）｜LOST（流失，必填原因）
//
// 一条铁律：**转化只发生在 CONSULTED → 转收案**。
// 从 LEAD 直接转收案的入口不提供——否则「到店谈案」这一段会被系统默认跳过，
// 数据上永远看不到真实转化漏斗（客户没来就签约，要么是线上成交，要么是数据造假）。
// ============================================================

enum LeadStage {
  LEAD // 线索：只有联系方式与来源
  INVITED // 已邀约：约了时间
  VISITED // 已到店
  CONSULTED // 已谈案：面谈或线上深谈完成，形成报价
  CONVERTED // 已转正式收案
  LOST // 流失
}

enum LeadSource {
  REFERRAL // 老客户转介绍
  ONLINE // 网络/搜索/公众号
  OFFLINE // 地推/活动
  PARTNER // 合作机构
  AD // 广告投放
  OTHER // 其他
}

/// 跟进动作类型——「获客 → 邀约 → 到店 → 谈案」四段各记一笔
enum LeadActivityType {
  CONTACT // 联系（电话/微信沟通）
  INVITE // 邀约（约定到店时间）
  VISIT // 到店
  CONSULT // 谈案（面谈纪要、报价）
  NOTE // 备注
}

model Lead {
  id                String         @id @default(cuid())
  /// 线索人姓名（不是客户名——此时还不是客户）
  name              String
  phone             String?
  wechat            String?
  /// 单位/公司（若为企业线索）
  organization      String?
  source            LeadSource     @default(OTHER)
  /// 来源细节（谁介绍的、哪个平台、哪场活动）
  sourceDetail      String?
  stage             LeadStage      @default(LEAD)
  /// 意向业务类别，与 MatterCategory 同枚举，便于按类别算转化率
  category          MatterCategory @default(CIVIL_COMMERCIAL)
  /// 预计标的/预计收费（获客看板用它算预期收入，不影响财务）
  expectedAmount    Decimal?       @db.Decimal(14, 2)
  /// 负责人（跟进人）
  ownerId           String
  owner             User           @relation("LeadOwner", fields: [ownerId], references: [id])
  /// 邀约时间（约定到店/线上谈的时间）
  invitedAt         DateTime?
  /// 实际到店时间
  visitedAt         DateTime?
  /// 谈案完成时间
  consultedAt       DateTime?
  lostReason        String?
  lostAt            DateTime?
  /// 转化后的收案（唯一）。转收案时回填，用于算转化率与回看
  convertedIntakeId String?        @unique
  convertedIntake   Intake?        @relation(fields: [convertedIntakeId], references: [id])
  convertedAt       DateTime?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  activities LeadActivity[]

  @@index([stage, createdAt])
  @@index([ownerId, stage])
  @@index([source])
}

model LeadActivity {
  id          String           @id @default(cuid())
  leadId      String
  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        LeadActivityType
  /// 动作发生的时刻（上海口径由调用方给出）
  happenedAt  DateTime         @default(now())
  /// 渠道/方式（电话、微信、面谈……自由文本，不枚举——枚举只会逼人乱选）
  channel     String?
  note        String?
  /// 记录人
  createdById String
  createdBy   User             @relation("LeadActivityAuthor", fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())

  @@index([leadId, happenedAt])
}
